
{
  "headers": [
    {
      "source": "/juego",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/juego",
      "destination": "/index.html"
    },
    {
      "source": "/conoce-el-juego",
      "destination": "/index.html"
    },
    {
      "source": "/equipo/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/index.html"
    },
    {
      "source": "/terminos",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/index.html"
    }
  ]
}
